# Installed as /etc/honeypot-agent.env.example. The installer also creates
# /etc/honeypot-agent.env when absent. Edit only the actual file; keep 0600.
# Fill blank fields for this sensor. Never commit the completed file.
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=
MONGO_URI=
MONGO_DATABASE=honeypot_db
SENSOR_NAME=
SENSOR_LAN_IP=
SENSOR_LAN_IFACE=
SENSOR_ZT_IP=
SENSOR_ZT_IFACE=
SENSOR_ZEROTIER_IP=
SENSOR_ZEROTIER_IFACE=
SENSOR_WG_IP=
SENSOR_WG_IFACE=
WEB_CORP_SENSOR_IP=
WEB_CORP_SENSOR_IFACE=
ALLOW_RESP_PORTS=
READ_FROM_START=
COWRIE_LOG_FILE=
ZEEK_CONN_LOG=
ZEEK_SSH_LOG=
ZEEK_SSL_LOG=
ZEEK_DNS_LOG=
ZEEK_HTTP_LOG=
ZEEK_FILES_LOG=
ZEEK_NOTICE_LOG=
