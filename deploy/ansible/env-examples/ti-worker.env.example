# Installed as /etc/honeypot/ti-worker.env.example. The installer creates
# ti-worker.env when absent. Edit only the actual file; keep mode 0600.
# Provider keys are optional for a worker that is not yet doing lookups.
TI_CONSUMER_GROUP=ti-worker
TI_CONSUMER_NAME=ti-worker-1
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
