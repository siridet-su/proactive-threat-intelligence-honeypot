# Installed as /etc/honeypot/backup.env.example. The installer creates
# backup.env when absent. Edit only the actual file; keep mode 0600.
# The control service uses dashboard schedule revisions. The B2 destination
# and credentials are supplied by the operator after the private bucket is ready.
BACKUP_MODE=control
BACKUP_TARGETS=hardware_metrics_1m,filesystem_audit
BACKUP_ROOT=/var/lib/honeypot/hardware-backups
BACKUP_LOOKBACK_DAYS=30
BACKUP_SAFETY_DAYS=2
B2_BUCKET=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
BACKUP_ALLOW_SENSITIVE=false
