{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proactive-threat-intelligence-honeypot:schema:hardware_telemetry_sample:v1",
  "title": "Cowrie Hardware Fusion Telemetry Sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "run_id",
    "experiment_id",
    "phase",
    "metric_scope",
    "subject_id",
    "time",
    "collector",
    "correlation",
    "cpu",
    "memory",
    "disk",
    "network",
    "thermal",
    "process",
    "privacy",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "hardware_telemetry_sample.v1"
    },
    "sample_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "experiment_id": {
      "$ref": "#/$defs/identifier"
    },
    "phase": {
      "enum": ["baseline", "workload", "recovery", "cooldown"]
    },
    "metric_scope": {
      "enum": [
        "pi_sensor",
        "backend_guest",
        "backend_cgroup",
        "target_process",
        "local_sink"
      ]
    },
    "subject_id": {
      "$ref": "#/$defs/identifier"
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "monotonic_ns",
        "boot_id_sha256",
        "sequence",
        "sample_interval_seconds",
        "ntp_synchronized"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "boot_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "sample_interval_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "ntp_synchronized": {
          "type": "boolean"
        },
        "clock_error_bound_ms": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_id", "version", "source_sha256", "feature_schema_sha256"],
      "properties": {
        "collector_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "state", "canonical_session_ids", "command_event_ids"],
      "properties": {
        "sensor_id": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "enum": ["exact", "temporal_only", "no_active_session", "ambiguous"]
        },
        "canonical_session_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "command_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utilization_semantics", "core_count", "total_percent", "per_core_percent"],
      "properties": {
        "utilization_semantics": {
          "const": "aggregate_busy_percent_0_100"
        },
        "core_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "total_percent": {
          "$ref": "#/$defs/percent"
        },
        "per_core_percent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/percent"
          }
        },
        "user_percent": {
          "$ref": "#/$defs/percent"
        },
        "system_percent": {
          "$ref": "#/$defs/percent"
        },
        "iowait_percent": {
          "$ref": "#/$defs/percent"
        },
        "irq_percent": {
          "$ref": "#/$defs/percent"
        },
        "steal_percent": {
          "$ref": "#/$defs/percent"
        },
        "load_1m": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "load_5m": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "load_15m": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "frequency_mhz": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "context_switches_total": {
          "type": "integer",
          "minimum": 0
        },
        "pressure": {
          "$ref": "#/$defs/pressure_observation"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_bytes", "available_bytes", "used_bytes", "used_percent", "swap_total_bytes", "swap_used_bytes"],
      "properties": {
        "total_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "available_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "used_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "used_percent": {
          "$ref": "#/$defs/percent"
        },
        "cache_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "swap_total_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "swap_used_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "page_faults_total": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "major_page_faults_total": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "oom_kills_total": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "pressure": {
          "$ref": "#/$defs/pressure_observation"
        }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_used_bytes", "root_used_percent", "devices"],
      "properties": {
        "root_used_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "root_used_percent": {
          "$ref": "#/$defs/percent"
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_id", "read_bytes_total", "write_bytes_total", "read_bytes_per_second", "write_bytes_per_second"],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/identifier"
              },
              "read_bytes_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "write_bytes_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "read_bytes_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "write_bytes_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "reads_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "writes_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "io_time_percent": {
                "$ref": "#/$defs/percent"
              }
            }
          }
        },
        "pressure": {
          "$ref": "#/$defs/pressure_observation"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interfaces", "connection_count", "socket_count"],
      "properties": {
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "accounting_role",
              "include_in_aggregate",
              "up",
              "rx_bytes_total",
              "tx_bytes_total",
              "rx_bytes_per_second",
              "tx_bytes_per_second",
              "rx_packets_total",
              "tx_packets_total",
              "rx_packets_per_second",
              "tx_packets_per_second",
              "rx_errors_total",
              "tx_errors_total",
              "rx_drops_total",
              "tx_drops_total"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/identifier"
              },
              "accounting_role": {
                "enum": [
                  "primary_physical",
                  "other_physical",
                  "overlay_observability",
                  "loopback_observability",
                  "local_sink",
                  "other"
                ]
              },
              "include_in_aggregate": {
                "type": "boolean"
              },
              "up": {
                "type": "boolean"
              },
              "rx_bytes_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "tx_bytes_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "rx_bytes_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "tx_bytes_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "rx_packets_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "tx_packets_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "rx_packets_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "tx_packets_per_second": {
                "$ref": "#/$defs/nonnegative_number"
              },
              "rx_errors_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "tx_errors_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "rx_drops_total": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "tx_drops_total": {
                "$ref": "#/$defs/nonnegative_integer"
              }
            }
          }
        },
        "connection_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "socket_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "unique_destination_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "dns_queries_per_second": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "tcp_states": {
          "$ref": "#/$defs/tcp_states"
        },
        "socket_summary": {
          "$ref": "#/$defs/socket_summary"
        },
        "tcp_pressure": {
          "$ref": "#/$defs/tcp_pressure"
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature_c", "throttled", "undervoltage"],
      "properties": {
        "temperature_c": {
          "type": ["number", "null"],
          "minimum": -50,
          "maximum": 200
        },
        "throttled": {
          "type": ["boolean", "null"]
        },
        "undervoltage": {
          "type": ["boolean", "null"]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_count", "thread_count", "target"],
      "properties": {
        "process_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "thread_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "target": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["process_id_hash", "parent_process_id_hash", "cpu_percent_single_core_basis", "rss_bytes", "thread_count", "socket_count", "cgroup_id"],
          "properties": {
            "process_id_hash": {
              "$ref": "#/$defs/sha256"
            },
            "parent_process_id_hash": {
              "anyOf": [
                {"$ref": "#/$defs/sha256"},
                {"type": "null"}
              ]
            },
            "cpu_percent_single_core_basis": {
              "type": "number",
              "minimum": 0,
              "maximum": 102400
            },
            "rss_bytes": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "thread_count": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "socket_count": {
              "anyOf": [
                {"$ref": "#/$defs/nonnegative_integer"},
                {"type": "null"}
              ]
            },
            "cgroup_id": {
              "type": ["string", "null"],
              "maxLength": 128
            },
            "voluntary_context_switches_total": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "involuntary_context_switches_total": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "tcp_states": {
              "$ref": "#/$defs/tcp_states"
            },
            "socket_summary": {
              "$ref": "#/$defs/socket_summary"
            },
            "tcp_pressure": {
              "$ref": "#/$defs/tcp_pressure"
            },
            "cgroup": {
              "anyOf": [
                {"$ref": "#/$defs/cgroup_observation"},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_command", "contains_credentials", "contains_raw_ip"],
      "properties": {
        "contains_raw_command": {
          "const": false
        },
        "contains_credentials": {
          "const": false
        },
        "contains_raw_ip": {
          "const": false
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "missing_fields", "counter_resets", "sample_late", "collector_errors"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "counter_resets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "sample_late": {
          "type": "boolean"
        },
        "late_by_ms": {
          "type": "number",
          "minimum": 0
        },
        "collector_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  },
  "$defs": {
    "pressure_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["some"],
      "properties": {
        "some": {"$ref": "#/$defs/pressure_line"},
        "full": {"$ref": "#/$defs/pressure_line"}
      }
    },
    "pressure_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avg10_percent", "avg60_percent", "avg300_percent", "total_stall_usec", "stall_usec_per_second"],
      "properties": {
        "avg10_percent": {"$ref": "#/$defs/percent"},
        "avg60_percent": {"$ref": "#/$defs/percent"},
        "avg300_percent": {"$ref": "#/$defs/percent"},
        "total_stall_usec": {"$ref": "#/$defs/nonnegative_integer"},
        "stall_usec_per_second": {"$ref": "#/$defs/nonnegative_number"}
      }
    },
    "tcp_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["established", "syn_sent", "syn_received", "fin_wait_1", "fin_wait_2", "time_wait", "closed", "close_wait", "last_ack", "listen", "closing", "new_syn_received", "total"],
      "properties": {
        "established": {"$ref": "#/$defs/nonnegative_integer"},
        "syn_sent": {"$ref": "#/$defs/nonnegative_integer"},
        "syn_received": {"$ref": "#/$defs/nonnegative_integer"},
        "fin_wait_1": {"$ref": "#/$defs/nonnegative_integer"},
        "fin_wait_2": {"$ref": "#/$defs/nonnegative_integer"},
        "time_wait": {"$ref": "#/$defs/nonnegative_integer"},
        "closed": {"$ref": "#/$defs/nonnegative_integer"},
        "close_wait": {"$ref": "#/$defs/nonnegative_integer"},
        "last_ack": {"$ref": "#/$defs/nonnegative_integer"},
        "listen": {"$ref": "#/$defs/nonnegative_integer"},
        "closing": {"$ref": "#/$defs/nonnegative_integer"},
        "new_syn_received": {"$ref": "#/$defs/nonnegative_integer"},
        "total": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "socket_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sockets_used", "tcp_inuse", "tcp_orphan", "tcp_time_wait", "tcp_allocated", "tcp_memory_pages", "udp_inuse", "udp_memory_pages", "tcp6_inuse", "udp6_inuse"],
      "properties": {
        "sockets_used": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp_inuse": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp_orphan": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp_time_wait": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp_allocated": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp_memory_pages": {"$ref": "#/$defs/nonnegative_integer"},
        "udp_inuse": {"$ref": "#/$defs/nonnegative_integer"},
        "udp_memory_pages": {"$ref": "#/$defs/nonnegative_integer"},
        "tcp6_inuse": {"$ref": "#/$defs/nonnegative_integer"},
        "udp6_inuse": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "tcp_pressure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen_overflows_total": {"$ref": "#/$defs/nonnegative_integer"},
        "listen_overflows_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "listen_drops_total": {"$ref": "#/$defs/nonnegative_integer"},
        "listen_drops_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "request_queue_full_cookies_total": {"$ref": "#/$defs/nonnegative_integer"},
        "request_queue_full_cookies_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "request_queue_full_drops_total": {"$ref": "#/$defs/nonnegative_integer"},
        "request_queue_full_drops_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "backlog_drops_total": {"$ref": "#/$defs/nonnegative_integer"},
        "backlog_drops_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "memory_pressure_events_total": {"$ref": "#/$defs/nonnegative_integer"},
        "memory_pressure_events_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "aborts_on_memory_total": {"$ref": "#/$defs/nonnegative_integer"},
        "aborts_on_memory_per_second": {"$ref": "#/$defs/nonnegative_number"},
        "receive_queue_drops_total": {"$ref": "#/$defs/nonnegative_integer"},
        "receive_queue_drops_per_second": {"$ref": "#/$defs/nonnegative_number"}
      }
    },
    "counter_block": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nonnegative_number"}
    },
    "cgroup_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"$ref": "#/$defs/counter_block"},
        "memory": {"$ref": "#/$defs/counter_block"},
        "pids": {"$ref": "#/$defs/counter_block"},
        "io": {"$ref": "#/$defs/counter_block"},
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"$ref": "#/$defs/pressure_observation"},
            "memory": {"$ref": "#/$defs/pressure_observation"},
            "io": {"$ref": "#/$defs/pressure_observation"}
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    }
  }
}
