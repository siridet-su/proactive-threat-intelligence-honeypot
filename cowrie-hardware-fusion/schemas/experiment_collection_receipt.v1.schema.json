{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proactive-threat-intelligence-honeypot:schema:experiment_collection_receipt:v1",
  "title": "Experimental Telemetry Collection Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "receipt_sha256", "run_id", "experiment_id", "metric_scope", "state", "started_at", "ended_at", "collector", "record_count", "phase_record_counts", "serialized_bytes", "segments"],
  "properties": {
    "schema_version": {"const": "experiment_collection_receipt.v1"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "metric_scope": {"const": "pi_sensor"},
    "state": {"const": "completed"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_id", "version", "source_sha256", "feature_schema_sha256"],
      "properties": {
        "collector_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "feature_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record_count": {"type": "integer", "minimum": 1},
    "phase_record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "workload", "recovery"],
      "properties": {
        "baseline": {"type": "integer", "minimum": 1},
        "workload": {"type": "integer", "minimum": 1},
        "recovery": {"type": "integer", "minimum": 1}
      }
    },
    "serialized_bytes": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "first_sequence", "last_sequence", "record_count", "serialized_bytes", "sha256"],
        "properties": {
          "filename": {"type": "string", "pattern": "^part-[0-9]{6}-[0-9]{6}-[a-f0-9]{64}\\.jsonl$"},
          "first_sequence": {"type": "integer", "minimum": 0},
          "last_sequence": {"type": "integer", "minimum": 0},
          "record_count": {"type": "integer", "minimum": 1},
          "serialized_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
