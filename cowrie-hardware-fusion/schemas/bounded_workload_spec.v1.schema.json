{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proactive-threat-intelligence-honeypot:schema:bounded-workload-spec:v1",
  "title": "Bounded Ordinary Workload Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "scenario_catalog_sha256", "scenario_id", "runner", "security", "limits", "timing", "parameters", "input_policy"],
  "properties": {
    "schema_version": {"const": "bounded_workload_spec.v1"},
    "spec_id": {"$ref": "#/$defs/identifier"},
    "scenario_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_id": {"const": "benign_compute_control"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime", "image_sha256", "entrypoint_id", "implementation_sha256"],
      "properties": {
        "kind": {"const": "oci_container_in_disposable_vm"},
        "runtime": {"enum": ["docker", "podman"]},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "entrypoint_id": {"const": "cpu_duty_cycle_v1"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_mode", "network_policy_sha256", "read_only_rootfs", "cap_drop_all", "no_new_privileges", "seccomp_profile_sha256"],
      "properties": {
        "network_mode": {"const": "none"},
        "network_policy_sha256": {"$ref": "#/$defs/sha256"},
        "read_only_rootfs": {"const": true},
        "cap_drop_all": {"const": true},
        "no_new_privileges": {"const": true},
        "seccomp_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_capacity_millicores", "cpu_quota_millicores", "memory_max_bytes", "pids_max", "tmpfs_max_bytes", "output_max_bytes"],
      "properties": {
        "cpu_capacity_millicores": {"type": "integer", "minimum": 100, "maximum": 64000},
        "cpu_quota_millicores": {"type": "integer", "minimum": 25, "maximum": 57600},
        "memory_max_bytes": {"type": "integer", "minimum": 67108864, "maximum": 1073741824},
        "pids_max": {"type": "integer", "minimum": 1, "maximum": 64},
        "tmpfs_max_bytes": {"type": "integer", "minimum": 1048576, "maximum": 134217728},
        "output_max_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_seconds", "watchdog_timeout_seconds", "termination_grace_seconds"],
      "properties": {
        "workload_seconds": {"enum": [10, 30, 60, 120]},
        "watchdog_timeout_seconds": {"type": "integer", "minimum": 15, "maximum": 180},
        "termination_grace_seconds": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intensity_percent", "duty_cycle_period_ms", "deterministic_seed"],
      "properties": {
        "intensity_percent": {"enum": [25, 50, 75, 90]},
        "duty_cycle_period_ms": {"type": "integer", "minimum": 50, "maximum": 1000},
        "deterministic_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attacker_controlled_input", "fixed_entrypoint_only", "raw_cowrie_command_allowed"],
      "properties": {
        "attacker_controlled_input": {"const": false},
        "fixed_entrypoint_only": {"const": true},
        "raw_cowrie_command_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
