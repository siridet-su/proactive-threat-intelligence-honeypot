{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proactive-threat-intelligence-honeypot:schema:service-pressure-workload-spec:v1",
  "title": "Service-pressure instrumentation workload specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "experiment_protocol", "scenario_catalog_sha256", "telemetry_contract", "scenario_id", "treatment", "runner", "security", "limits", "timing", "parameters", "host_gates", "input_policy", "claim_control"],
  "properties": {
    "schema_version": {"const": "service_pressure_workload_spec.v1"},
    "spec_id": {"$ref": "#/$defs/identifier"},
    "experiment_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_id", "protocol_sha256"],
      "properties": {
        "schema_version": {"const": "hardware_impact_experiment_protocol.v2"},
        "protocol_id": {"$ref": "#/$defs/identifier"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "telemetry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_sha256", "collector_source_sha256"],
      "properties": {
        "schema_version": {"const": "hardware_telemetry_sample.v1"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "collector_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario_id": {
      "enum": [
        "v2_benign_compute_low",
        "v2_benign_compute_high",
        "v2_t1496_001_compute_high",
        "v2_benign_service_low",
        "v2_benign_service_high",
        "v2_t1499_002_service_high"
      ]
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment_id", "workload_family", "protocol_intensity", "protocol_intensity_unit"],
      "properties": {
        "treatment_id": {"$ref": "#/$defs/identifier"},
        "workload_family": {"enum": ["bounded_compute", "bounded_service"]},
        "protocol_intensity": {"enum": [10, 25, 75, 150]},
        "protocol_intensity_unit": {"enum": ["assigned_cpu_percent", "requests_per_second"]}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime", "image_id", "entrypoint_id", "implementation_sha256"],
      "properties": {
        "kind": {"const": "oci_container_on_pi"},
        "runtime": {"const": "docker"},
        "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "entrypoint_id": {"const": "poc_workload_v1"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_mode", "read_only_rootfs", "cap_drop_all", "no_new_privileges", "run_as_uid", "run_as_gid"],
      "properties": {
        "network_mode": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "cap_drop_all": {"const": true},
        "no_new_privileges": {"const": true},
        "run_as_uid": {"const": 65532},
        "run_as_gid": {"const": 65532}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_limit_cores", "memory_max_bytes", "pids_max", "output_max_bytes"],
      "properties": {
        "cpu_limit_cores": {"enum": [0.25, 0.75]},
        "memory_max_bytes": {"const": 134217728},
        "pids_max": {"const": 16},
        "output_max_bytes": {"const": 4096}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_seconds", "binary_extra_seconds", "watchdog_timeout_seconds", "termination_grace_seconds"],
      "properties": {
        "workload_seconds": {"const": 30},
        "binary_extra_seconds": {"const": 2},
        "watchdog_timeout_seconds": {"const": 40},
        "termination_grace_seconds": {"const": 2}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workers", "duty_percent", "duty_period_ms", "requests_per_second", "work_iterations", "deterministic_seed"],
      "properties": {
        "mode": {"enum": ["compute", "service"]},
        "workers": {"type": "integer", "minimum": 1, "maximum": 4},
        "duty_percent": {"const": 100},
        "duty_period_ms": {"const": 100},
        "requests_per_second": {"type": "integer", "minimum": 1, "maximum": 150},
        "work_iterations": {"type": "integer", "minimum": 1, "maximum": 5000},
        "deterministic_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "host_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_available_memory_bytes", "minimum_free_disk_bytes", "maximum_temperature_c", "maximum_load_1m"],
      "properties": {
        "minimum_available_memory_bytes": {"const": 2147483648},
        "minimum_free_disk_bytes": {"const": 5368709120},
        "maximum_temperature_c": {"const": 75},
        "maximum_load_1m": {"const": 3}
      }
    },
    "input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attacker_controlled_input", "fixed_entrypoint_only", "raw_cowrie_command_allowed"],
      "properties": {
        "attacker_controlled_input": {"const": false},
        "fixed_entrypoint_only": {"const": true},
        "raw_cowrie_command_allowed": {"const": false}
      }
    },
    "claim_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilot_only", "training_eligible", "changes_frozen_feature_set", "simulator_receipt_is_model_feature"],
      "properties": {
        "pilot_only": {"const": true},
        "training_eligible": {"const": false},
        "changes_frozen_feature_set": {"const": false},
        "simulator_receipt_is_model_feature": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
