// Merge these entries into the existing tailnet policy. Do not replace the
// complete policy with this example.
{
  "tagOwners": {
    "tag:pti-dashboard": ["autogroup:admin"],
    "tag:honeypot-pi": ["autogroup:admin"],
  },

  "grants": [
    {
      "src": ["tag:pti-dashboard"],
      "dst": ["tag:honeypot-pi"],
      "ip": ["tcp:8788"],
    },
  ],

  "tests": [
    {
      "src": "tag:pti-dashboard",
      "proto": "tcp",
      "accept": ["tag:honeypot-pi:8788"],
      "deny": ["tag:honeypot-pi:22", "tag:honeypot-pi:8789"],
    },
  ],
}
