# Honeypot Sensor Forwarder - Main Configuration
# For Raspberry Pi: Cowrie log → GCP ingest_api
#
# Installation:
#   sudo install -m 600 -o root -g root \
#     honeypot-forwarder-main.env.example \
#     /etc/honeypot-forwarder/main.env
#
# Then edit:
#   sudo nano /etc/honeypot-forwarder/main.env
#
# And update in systemd:
#   [Service]
#   EnvironmentFile=/etc/honeypot-forwarder/main.env

# ============================================================================
# REQUIRED: GCP Ingest API Configuration
# ============================================================================

# Unique identifier for this honeypot sensor (string, no spaces)
SENSOR_ID=pi5-cowrie-01

# GCP ingest_api endpoint (HTTP or HTTPS)
INGEST_URL=http://34.124.181.196:8080/events

# Bearer token for authentication with GCP ingest_api
# SECURITY: Change this from test value before production!
# Get actual token from GCP deployment
HONEYPOT_API_TOKEN=test-token-change-me

# ============================================================================
# REQUIRED: Cowrie Log Configuration
# ============================================================================

# Path to Cowrie's standard JSON log file (NDJSON format)
# Find with: sudo find / -name "cowrie.json" 2>/dev/null
COWRIE_LOG_PATH=/home/cowrie/cowrie/var/log/cowrie/cowrie.json

# Path for local disk spool queue (stores events if GCP is down)
# Will be created by setup.sh with correct ownership
FORWARDER_SPOOL_PATH=/var/lib/honeypot-forwarder/sensor_spool.ndjson

# ============================================================================
# OPTIONAL: Performance Tuning
# ============================================================================

# Polling interval in tail-mode (seconds)
# Lower = more frequent checks (more CPU but lower latency)
# Higher = less frequent checks (lower CPU but higher latency)
FORWARDER_POLL_INTERVAL_SECONDS=5

# Maximum events per HTTP POST batch
# Lower = smaller requests (better for slow networks)
# Higher = more efficient but larger requests
FORWARDER_BATCH_SIZE=100

# HTTP request timeout in seconds
FORWARDER_TIMEOUT_SECONDS=30

# ============================================================================
# NOTE: Current Limitations
# ============================================================================

# 1. cowrie.json only (standard Cowrie events)
#    - cowrie_custom.json NOT forwarded yet (schema review pending)
#    - Only reading standard Cowrie JSON events
#
# 2. Resilience
#    - Events queue to disk if GCP ingest_api is down
#    - Automatic replay when connection restored
#    - Disk usage depends on event rate and outage duration
#
# 3. No local processing
#    - All analysis/enrichment happens on GCP side
#    - Pi only reads Cowrie log and forwards to GCP
#    - Existing Cowrie → SQLite → Dashboard pipeline untouched
