[Unit]
Description=Retain Cowrie artifact SHA-256 hashes and remove artifact bytes
After=cowrie.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cowrie-artifact-hash-retention
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cowrie/cowrie/var/lib/cowrie/downloads
ReadWritePaths=/var/lib/honeypot-artifact-retention
ReadWritePaths=/run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
RemoveIPC=true
