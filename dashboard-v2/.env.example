# MongoDB Connection String (Required)
# Replace <username> and <password> with your MongoDB Atlas credentials
MONGODB_URI="mongodb+srv://<username>:<password>@honeypot-db.o4c0xzu.mongodb.net/?appName=Honeypot-DB"

# Required outside local development: generate with `openssl rand -base64 48`; never commit the real value.
AUTH_SESSION_SECRET="replace_with_a_random_48_byte_secret"

# Required in production for the built-in Admin account. Development alone accepts admin/admin.
PTI_ADMIN_PASSWORD="replace_with_a_strong_admin_password"

# AbuseIPDB API Key (Required for Threat Intel features)
# Get your free API key at: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY="your_abuseipdb_api_key_here"
