[Unit]
Description=Model2 V7 bounded capstone HAProxy backend PCAP ring
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0007
ExecStart=/usr/bin/tcpdump -Z model2v7 -i tailscale0 -nn -s 0 -U -C 8 -W 8 -w /var/lib/model2-v7/pcap/backend.pcap host 100.118.43.30 and tcp port 2224
Restart=always
RestartSec=2
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/model2-v7/pcap
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
