  "enum_bindings": {
    "semantic_family": {
      "mode": "hash_bound_deterministic_source",
      "source": "typed_semantic_vocabulary_policy.v2",
      "binding": "projection.provenance.typed_vocabulary_sha256"
    },
    "operation_type": {
      "mode": "hash_bound_deterministic_source",
      "source": "typed_semantic_vocabulary_policy.v2.operations",
      "binding": "projection.provenance.typed_vocabulary_sha256"
    },
    "outcome_status": {
      "mode": "hash_bound_deterministic_source",
      "source": "typed_semantic_vocabulary_policy.v2.outcome_statuses",
      "binding": "projection.provenance.typed_vocabulary_sha256"
    },
    "relationship_type": {
      "mode": "validated_graph_source",
      "source": "canonical_semantic_graph.v1.relationship_edges.relationship_type",
      "binding": "projection.graph_sha256"
    },
    "chain_status": [
      "supported",
      "partial"
    ],
    "relationship_status": [
      "supported",
      "partial"
    ],
    "finding_status": [
      "supported"
    ],
    "finding_priority_band": [
      "not_applicable",
      "reviewed_low",
      "reviewed_medium",
      "reviewed_high",
      "reviewed_critical"
    ],
    "hypothesis_status": [
      "bounded_unverified_alternative"
    ],
    "action_execution_integration": [
      "not_implemented"
    ],
    "review_plan_step_type": [
      "review_chain",
      "review_finding",
      "test_existing_hypothesis",
      "perform_manual_check",
      "resolve_evidence_gap"
    ],
    "review_plan_anchor_type": [
      "chain",
      "finding",
      "hypothesis",
      "action",
      "evidence_gap"
    ],
    "rendered_status": [
      "rendered",
      "abstained"
    ],
    "record_status": [
      "accepted",
      "abstained",
      "rejected",
      "unavailable"
    ],
    "validation_status": [
      "accepted",
      "rejected"
    ],
    "completion_code": [
      "accepted",
      "rejected",
      "cache_replayed",
      "deterministic_abstention"
    ]
  },
  "chronology": {
    "sources": [
      "canonical_semantic_graph.evidence_nodes.sequence_index",
      "canonical_semantic_graph.relationship_edges.source_fact_ref",
      "canonical_semantic_graph.relationship_edges.target_fact_ref"
    ],
    "chain_fact_list_is_chronology": false,
    "classification_only_missing_sequence_creates_step": false,
    "tie_breakers": [
      "durable_sequence_index",
      "directed_topological_order",
      "stable_object_id"
    ],
    "invalid_conditions": [
      "cycle",
      "edge_contradicts_durable_order",
      "unresolved_causal_placement",
      "duplicate_ordinal",
      "non_contiguous_dense_ordinal"
    ],
    "invalid_behavior": "affected_chain_ineligible_then_local_abstention_if_no_context"
  },
  "privacy": {
    "alias_format": "^a_[0-9a-f]{32}$",
    "alias_derivation": "HMAC-SHA256(alias_key, provider_id || assessment_id || object_kind || local_id), truncated to 32 hex after local collision check",
    "allowed_value_classes": [
      "assessment_scoped_alias",
      "closed_enum",
      "boolean",
      "bounded_integer",
      "sha256",
      "reviewed_policy_id"
    ],
    "prohibited_fields": [
      "raw_command",
      "command_fragment",
      "durable_event_ref",
      "source_ip",
      "destination_address",
      "username",
      "password",
      "credential",
      "url",
      "payload",
      "filename",
      "entity_value",
      "description",
      "statement",
      "previous_ai_prose"
    ]
  },
  "eligibility": {
    "required_all": [
      "valid_current_session_assessment_v6",
      "valid_graph_and_guidance_identities",
      "chronology_internally_consistent"
    ],
    "primary_context_any": [
      "at_least_one_ai_eligible_chain",
      "at_least_two_trusted_findings"
    ],
    "secondary_context_any": [
      "approved_manual_action",
      "existing_bounded_hypothesis",
      "additional_trusted_finding_or_chain",
      "existing_limitation",
      "existing_evidence_gap"
    ],
    "ineligible_behavior": "persist_local_non_provider_abstention",
    "learned_router": false
  },
  "compatibility": {
    "historical_read_only": [
      "session_assessment.v4",
      "session_assessment.v5",
      "response_guidance.v3",
      "ai_advisory_record.v1"
    ],
    "shadow_candidates": "historical_v1_read_only_not_present_in_v2",
    "historical_rewrite": false,
    "historical_requeue": false,
    "database_migration_required": false,
    "storage_reuse": [
      "ai_advisory_outbox",
      "ai_advisories"
    ],
    "prediction_contract_changed": false
  },
  "evaluation_protocol": {
    "conditions": [
      "deterministic_default_ordering",
      "historical_flat_ai_selector_v1",
      "final_f_chronological_graph_synthesis_v2"
    ],
    "case_count": 40,
    "real_nonsealed_development_cases": 30,
    "synthetic_contract_edge_cases": 10,
    "strata": {
      "simple_or_insufficient": 10,
      "one_chain_multi_finding": 10,
      "multi_chain_or_multi_action": 10,
      "existing_hypothesis_limitation_or_gap": 10
    },
    "independent_reviewers_required_for_analyst_claims": 2,
    "single_reviewer_claim_scope": "descriptive_only",
    "repeat_stability_subset_cases": 12,
    "repeat_calls_per_case": 3,
    "metrics": [
      "valid_reference_rate",
      "prohibited_output_rate",
      "grounding_consistency",
      "top_k_finding_recall",
      "finding_ndcg",
      "action_rank_agreement",
      "analyst_omission_rate",
      "analyst_review_time",
      "abstention_appropriateness",
      "repeated_call_stability",
      "provider_failure_containment",
      "api_invocation_rate",
      "latency",
      "token_usage",
      "cost"
    ],
    "prohibited_claims": [
      "attck_accuracy",
      "novel_threat_discovery",
      "attacker_intent_inference",
      "hypothesis_truth",
      "soc_efficacy",
      "autonomous_response"
