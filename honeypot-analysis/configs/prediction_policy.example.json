{
  "schema_version": "prediction_policy.v1",
  "policy_id": "honeypot-realtime-default",
  "version": "2026-05-17",
  "updated_at": "2026-05-17T00:00:00Z",
  "owner": "honeypot-cloud-analysis",
  "policy": {
    "enabled": true,
    "max_hypotheses": 5,
    "min_score": 0.01,
    "min_sessions_for_local": 50,
    "min_transition_count": 2,
    "transition_history_limit": 500,
    "external_transition_model_path": "",
    "external_min_sessions": 50,
    "external_min_transition_count": 2,
    "prefix_max_length": 3,
    "transition_smoothing": 0.05,
    "technique_to_tactic_aggregation": "max",
    "technique_tactic_map": {},
    "recency_decay_half_life_sessions": 500,
    "min_prefix_transition_count": 2,
    "min_technique_transition_count": 2,
    "min_tactic_transition_count": 2,
    "min_active_scorers": 2,
    "below_minimum_behavior": "low_confidence_flag",
    "confidence_damping": {
      "enabled": true,
      "mode": "geometric_mean",
      "damped_scorers": [
        "local_transition",
        "external_seed_transition",
        "actor_fingerprint_transition",
        "fallback_progression",
        "tactic_combination",
        "mitre_association"
      ]
    },
    "weights": {
      "local_transition": 0.3,
      "external_seed_transition": 0.2,
      "actor_fingerprint_transition": 0.0,
      "fallback_progression": 0.1,
      "tactic_combination": 0.12,
      "mitre_association": 0.13,
      "sigma_correlation": 0.05,
      "enrichment_context": 0.1
    },
    "enrichment_context_mode": "scorer",
    "enrichment_context_multiplier": {
      "max_multiplier": 1.15,
      "min_enrichment_score": 0.01
    },
    "external_seed_weight_decay": {
      "enabled": true,
      "method": "maturity_multiplier",
      "cold": 1.0,
      "warming": 0.5,
      "stable": 0.2,
      "shrinkage_count_source": "transitions",
      "shrinkage_k": 200.0,
      "min_multiplier": 0.0,
      "max_multiplier": 1.0
    },
    "actor_fingerprint_prior": {
      "enabled": false,
      "match_fields": ["hassh_fingerprint", "ja3_fingerprint", "command_pattern_hash"],
      "min_sessions": 2,
      "min_transition_count": 1,
      "min_prefix_transition_count": 1,
      "min_tactic_transition_count": 1,
      "prefix_max_length": 3,
      "smoothing": 0.05,
      "history_limit": 500,
      "model_path": "",
      "comparison_weight": 0.15
    },
    "behavior_regime_classifier": {
      "enabled": true,
      "min_commands": 2,
      "automated_command_rate_per_minute": 8.0,
      "human_command_rate_per_minute": 1.5,
      "low_delay_variance_seconds2": 4.0,
      "high_delay_variance_seconds2": 900.0,
      "high_entropy_bits_per_char": 4.2,
      "low_entropy_bits_per_char": 2.5,
      "low_payload_diversity": 0.40,
      "high_payload_diversity": 0.80,
      "automated_threshold": 0.65,
      "human_threshold": 0.35,
      "feature_weights": {
        "command_frequency": 0.35,
        "delay_regularity": 0.25,
        "command_entropy": 0.20,
        "payload_repetition": 0.20
      }
    },
    "confidence_controls": {
      "enabled": true,
      "single_active_scorer_cap": "medium",
      "single_supporting_scorer_cap": "medium",
      "external_seed_only_cap": "low",
      "external_seed_dominated_cap": "medium",
      "context_only_cap": "low",
      "medium_divergence_ratio": 0.5,
      "medium_divergence_cap": "medium",
      "high_divergence_ratio": 0.75,
      "high_divergence_cap": "low",
      "low_classification_geomean": 0.65,
      "unknown_or_noise_ratio": 0.4,
      "low_classification_cap": "low"
    },
    "prediction_triggers": {
      "enabled": true,
      "eventids": [
        "cowrie.login.success",
        "cowrie.login.failed",
        "cowrie.session.file_download",
        "cowrie.session.file_upload",
        "cowrie.session.closed"
      ],
      "eventid_prefixes": [
        "cowrie.command."
      ]
    },
    "predictive_alerts": {
      "enabled": true,
      "min_confidence": "medium",
      "min_score": 0.5,
      "min_severity": "high",
      "min_active_scorers": 2,
      "min_supporting_scorers": 2,
      "block_on_coverage_below_minimum": true,
      "max_divergence_ratio": 0.5,
      "block_external_seed_only": true,
      "block_context_only": true,
      "alert_on_session_status": [
        "active"
      ],
      "max_alerts_per_snapshot": 1,
      "risk_annotation_severity_boost": {
        "enabled": false,
        "min_risk_level": "high",
        "boost_high_to_critical": false
      },
      "tactic_severity": {
        "credential-access": "medium",
        "defense-evasion": "medium",
        "command-and-control": "high",
        "persistence": "high",
        "privilege-escalation": "high",
        "lateral-movement": "critical",
        "exfiltration": "critical",
        "impact": "critical"
      }
    },
    "vulnerability_risk": {
      "enabled": true,
      "default_tactic": "impact",
      "high_epss_threshold": 0.7,
      "medium_epss_threshold": 0.3,
      "epss_scores": {
        "CVE-2024-0001": 0.0
      }
    },
    "risk_annotators": {
      "vulnerability_risk": {
        "enabled": true
      }
    },
    "calibration": {
      "enabled": false,
      "method": "empirical_binning",
      "min_cases_per_bin": 20,
      "bins": []
    },
    "rule_prior_deduplication": {
      "enabled": true,
      "method": "max_contribution",
      "scorers": ["tactic_combination", "mitre_association"],
      "require_shared_evidence_key": true
    },
    "fallback_progression": {
      "initial-access": ["execution", "discovery", "persistence"],
      "execution": ["discovery", "credential-access", "collection"],
      "discovery": ["credential-access", "lateral-movement", "collection"],
      "credential-access": ["persistence", "lateral-movement", "exfiltration"],
      "persistence": ["defense-evasion", "command-and-control", "collection"],
      "privilege-escalation": ["defense-evasion", "credential-access", "persistence"],
      "defense-evasion": ["collection", "command-and-control", "exfiltration"],
      "lateral-movement": ["collection", "command-and-control", "exfiltration"],
      "collection": ["exfiltration", "command-and-control"],
      "command-and-control": ["exfiltration", "impact"],
      "exfiltration": ["impact"],
      "impact": []
    },
    "maturity": {
      "cold": {
        "max_usable_sessions": 49,
        "max_transition_count": 49
      },
      "warming": {
        "min_usable_sessions": 50,
        "min_transition_count": 50,
        "max_usable_sessions": 199,
        "max_transition_count": 299
      },
      "stable": {
        "min_usable_sessions": 200,
        "min_transition_count": 300
      },
      "cold_confidence_cap": "low",
      "warming_confidence_cap": ""
    },
    "tactic_combination_rules": [
      {
        "rule_id": "example-discovery-credential-access",
        "enabled": false,
        "source_type": "heuristic_prior",
        "inference_type": "human_curated_tactic_combination",
        "temporal_claim": false,
        "provenance": {
          "method": "manual_review",
          "basis": ["ATT&CK tactic semantics", "operator review"],
          "author": "developer",
          "reviewed": false,
          "created": "2026-05-20",
          "version": "1.0"
        },
        "required_tactics": ["discovery", "credential-access"],
        "evidence_sources": ["configured human-curated tactic combination prior"],
        "references": ["https://attack.mitre.org/"],
        "confidence_policy": "heuristic prior only; rank below local transition evidence",
        "hypotheses": [
          {
            "tactic": "command-and-control",
            "score": 0.3,
            "reason": "example prior for review only"
          }
        ]
      }
    ],
    "mitre_association_rules": [
      {
        "rule_id": "tie-style-t1059-t1105-association",
        "enabled": false,
        "source_type": "human_curated_attck_prior",
        "inference_type": "associated_technique_prior",
        "temporal_claim": false,
        "provenance": {
          "method": "manual_review",
          "basis": ["ATT&CK technique pages", "CTID TIE concept"],
          "author": "developer",
          "reviewed": false,
          "generated_by_tie": false,
          "created": "2026-05-20",
          "version": "1.0"
        },
        "any_ttps": ["T1059", "T1105"],
        "evidence_sources": [
          "MITRE CTID Technique Inference Engine style associated-technique prior",
          "MITRE ATT&CK technique association / co-occurrence research"
        ],
        "references": [
          "https://github.com/center-for-threat-informed-defense/technique-inference-engine",
          "https://arxiv.org/abs/2211.06495",
          "https://arxiv.org/abs/2005.01654"
        ],
        "confidence_policy": "external prior only; do not treat as temporal ordering without local transition support",
        "hypotheses": [
          {
            "technique": "T1053",
            "tactic": "persistence",
            "score": 0.18,
            "reason": "configured ATT&CK association prior suggests checking persistence techniques related to observed execution/transfer behavior"
          }
        ]
      }
    ],
    "sigma_correlation_rules": [
      {
        "rule_id": "sigma-downloader-or-dropper-context",
        "enabled": false,
        "source_type": "detection_correlation",
        "inference_type": "indirect_detection_context",
        "temporal_claim": false,
        "provenance": {
          "method": "manual_review",
          "basis": ["Sigma generic detection methodology", "local Sigma hit/title/tag matching"],
          "author": "developer",
          "reviewed": false,
          "created": "2026-05-20",
          "version": "1.0"
        },
        "sigma_contains_any": ["download", "dropper", "wget", "curl"],
        "evidence_sources": ["Sigma rule tags or titles matched in the current session"],
        "references": ["https://sigmahq.io/"],
        "confidence_policy": "detection correlation only; use as context modifier unless backtested locally",
        "hypotheses": [
          {
            "technique": "T1105",
            "tactic": "command-and-control",
            "score": 0.2,
            "reason": "Sigma downloader/dropper context suggests possible payload staging or callback setup"
          }
        ]
      }
    ]
  }
}
