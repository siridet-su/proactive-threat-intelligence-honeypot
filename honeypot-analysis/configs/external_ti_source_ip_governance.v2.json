{
  "schema_version": "external_ti_source_ip_governance.v2",
  "policy_id": "honeypot-thesis-data-lifecycle.source-ip.external-ti",
  "version": "2.0.0",
  "status": "ACTIVE_BOUNDED_PRODUCTION",
  "parent_policy": {
    "policy_id": "honeypot-thesis-data-lifecycle",
    "version": "1.0.0",
    "source_path": "configs/data_lifecycle_policy.v1.json",
    "preserved_immutable": true
  },
  "amendment_scope": {
    "purpose": "non-authoritative threat-intelligence context for naturally observed production honeypot source IPs",
    "authorized_providers": [
      "shodan_official",
      "abuseipdb"
    ],
    "allowed_outbound_fields": [
      "normalized_source_ip"
    ],
    "source_role": "production_honeypot_observed_source_ip",
    "destination_role": "provider_lookup_endpoint",
    "lookup_only": true,
    "active_scanning": false,
    "reporting_or_submission": false,
    "continuous_processing": true,
    "arbitrary_external_ip_input": false
  },
  "eligibility": {
    "requires_existing_canonical_event": true,
    "requires_source_event_provenance": true,
    "requires_session_or_sensor_link": true,
    "requires_syntactically_valid_ip": true,
    "requires_ipv4_or_ipv6_global_routability": true,
    "exclude_private_rfc1918": true,
    "exclude_loopback": true,
    "exclude_link_local": true,
    "exclude_multicast": true,
    "exclude_unspecified_reserved": true,
    "exclude_carrier_grade_nat": true,
    "exclude_overlay_or_internal_addresses": true,
    "exclude_lab_controlled_fixture_addresses": true,
    "exclude_operator_owned_test_infrastructure": true,
    "destination_addresses_are_never_eligible": true,
    "selection_rule": "new naturally observed eligible Cowrie source event after the operator-bound cutoff"
  },
  "privacy_and_data_lifecycle": {
    "outbound_payload_minimization": "normalized_source_ip_only",
    "raw_provider_response_persisted": false,
    "normalized_bounded_fields_only": true,
    "canonical_mongodb_enrichment_record_write": false,
    "isolated_source_ip_cache": true,
    "source_ip_retained_only_in_isolated_cache_identity": true,
    "proof_guard_source_ip_representation": "sha256_normalized_public_ip",
    "provider_request_audit": "provider, fixed endpoint id, UTC time, outcome, bounded budget, and source-IP digest only"
  },
  "prohibited_outbound_fields": [
    "command_text",
    "command_hash",
    "username",
    "password",
    "credential",
    "session_id",
    "event_id",
    "event_payload",
    "cowrie_raw_json",
    "file_hash",
    "filename",
    "file_contents",
    "url",
    "domain",
    "hostname",
    "internal_private_topology",
    "telemetry",
    "report",
    "attack_prediction",
    "model1_output",
    "model2_output",
    "analyst_notes",
    "destination_ip"
  ],
  "provider_transport_review": {
    "shodan_official": {
      "endpoint_id": "shodan_host_v1",
      "adapter": "shodan_official",
      "authentication_form": "key query parameter",
      "automatic_internetdb_fallback": false,
      "request_method": "GET",
      "active_scans": false
    },
    "abuseipdb": {
      "endpoint_id": "abuseipdb_check_v2",
      "adapter": "abuseipdb",
      "authentication_form": "Key HTTP header",
      "request_method": "GET",
      "report_endpoint_or_method_permitted": false
    }
  },
  "request_budgets": {
    "minimum_refresh_interval_seconds": 86400,
    "max_distinct_source_ips_per_utc_day": 10,
    "max_attempts_per_provider_per_source_ip_per_window": 1,
    "retries": 0,
    "negative_result_cache_seconds": 86400,
    "failure_cache_seconds": 86400,
    "durable_quota_guard": true,
    "quota_collision_behavior": "fail_closed",
    "kill_switch": "EXTERNAL_TI_ENABLED=false or provider enabled=false"
  },
  "authority": {
    "eti_authority": "NON_AUTHORITATIVE_CONTEXT_ONLY",
    "trusted_attck_writes": 0,
    "trusted_history_writes": 0,
    "canonical_classification_overrides": 0,
    "response_actions": 0,
    "blocking_retaliation_attribution_exploitation": false
  },
  "rollback": {
    "rollback_action": "restore prior service environment and source-IP policy; restart worker",
    "canonical_record_mutation": false,
    "cached_context_may_expire_naturally": true
  },
  "activation": {
    "activation_scope": "bounded production lookups for newly observed eligible source IPs",
    "owner_authorization": "explicit owner direction to activate useful ETI without Censys",
    "runtime_service_config_requires_hash_binding": true,
    "health_check_and_rollback_required": true
  }
}
