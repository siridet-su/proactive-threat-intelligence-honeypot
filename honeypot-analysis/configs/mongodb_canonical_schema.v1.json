{
  "schema_version": "mongodb_canonical_schema_manifest.v1",
  "manifest_id": "honeypot-canonical-mongodb-v1",
  "database": "honeypot_canonical_v1",
  "canonical_event_order": ["received_at", "event_id"],
  "write_concern": {"w": "majority", "j": true},
  "read_concern": "majority",
  "authoritative_ttl_indexes_allowed": false,
  "prohibited_top_level_fields": ["authorization", "credentials", "password", "private_key", "raw_event", "raw_payload", "refresh_token"],
  "collections": [
    {
      "name": "events",
      "canonical_key": "event_id",
      "authority": "canonical_evidence",
      "retention": "policy_managed_no_ttl",
      "required_fields": ["_id", "schema_version", "event_id", "sensor_id", "session_id", "received_at", "payload_json", "payload_sha256", "processed", "attempts"],
      "indexes": [
        {"name": "uq_events_event_id", "keys": [["event_id", 1]], "unique": true},
        {"name": "ix_events_canonical_order", "keys": [["received_at", 1], ["event_id", 1]]},
        {"name": "ix_events_session_order", "keys": [["session_id", 1], ["received_at", 1], ["event_id", 1]]},
        {"name": "ix_events_claimable", "keys": [["processed", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["attempts", 1], ["received_at", 1], ["event_id", 1]]}
      ]
    },
    {"name": "event_processing", "canonical_key": "event_id", "authority": "canonical_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "event_id", "status"], "indexes": [{"name": "uq_event_processing_event", "keys": [["event_id", 1]], "unique": true}]},
    {"name": "session_dispatch", "canonical_key": "session_id", "authority": "canonical_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "session_id", "status"], "indexes": [{"name": "ix_session_dispatch_claimable", "keys": [["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["session_id", 1]]}]},
    {"name": "worker_leases", "canonical_key": "scope", "authority": "canonical_operational", "retention": "operational", "required_fields": ["_id", "schema_version", "scope", "owner", "token", "expires_at"], "indexes": [{"name": "uq_worker_lease_scope", "keys": [["scope", 1]], "unique": true}]},
    {"name": "sessions", "canonical_key": "session_id", "authority": "canonical_state", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "session_id", "revision", "payload_json", "updated_at"], "indexes": [{"name": "uq_sessions_session_id", "keys": [["session_id", 1]], "unique": true}, {"name": "ix_sessions_source_updated", "keys": [["session_source", 1], ["updated_at", -1], ["session_id", 1]]}]},
    {"name": "analysis_jobs", "canonical_key": "job_id", "authority": "canonical_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "job_id", "session_id", "status", "payload_json", "attempts"], "indexes": [{"name": "uq_analysis_job_id", "keys": [["job_id", 1]], "unique": true}, {"name": "ix_analysis_jobs_claimable", "keys": [["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["created_at", 1], ["job_id", 1]]}]},
    {"name": "canonical_assessments", "canonical_key": "assessment_id", "authority": "canonical_derived", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "assessment_id", "session_id", "payload_json", "payload_sha256"], "indexes": [{"name": "uq_assessment_id", "keys": [["assessment_id", 1]], "unique": true}, {"name": "ix_assessments_session", "keys": [["session_id", 1], ["created_at", -1], ["assessment_id", 1]]}]},
    {"name": "reports", "canonical_key": "report_id", "authority": "canonical_derived", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "report_id", "session_id", "payload_json", "payload_sha256"], "indexes": [{"name": "uq_report_id", "keys": [["report_id", 1]], "unique": true}, {"name": "ix_reports_session", "keys": [["session_id", 1], ["created_at", -1], ["report_id", 1]]}]},
    {"name": "prediction_outbox", "canonical_key": "outbox_id", "authority": "non_authoritative_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "outbox_id", "session_id", "status", "payload_json", "attempts"], "indexes": [{"name": "uq_prediction_outbox_id", "keys": [["outbox_id", 1]], "unique": true}, {"name": "ix_prediction_outbox_claimable", "keys": [["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["created_at", 1], ["outbox_id", 1]]}]},
    {"name": "prediction_snapshots", "canonical_key": "snapshot_id", "authority": "non_authoritative_derived", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "snapshot_id", "session_id", "payload_json"], "indexes": [{"name": "uq_prediction_snapshot_id", "keys": [["snapshot_id", 1]], "unique": true}, {"name": "ix_prediction_snapshots_session", "keys": [["session_id", 1], ["created_at", -1], ["snapshot_id", 1]]}]},
    {"name": "prediction_backtest_runs", "canonical_key": "run_id", "authority": "non_authoritative_audit", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "run_id", "payload_json"], "indexes": [{"name": "uq_prediction_backtest_run", "keys": [["run_id", 1]], "unique": true}]},
    {"name": "prediction_calibration_runs", "canonical_key": "run_id", "authority": "non_authoritative_audit", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "run_id", "payload_json"], "indexes": [{"name": "uq_prediction_calibration_run", "keys": [["run_id", 1]], "unique": true}]},
    {"name": "ai_advisory_outbox", "canonical_key": "job_id", "authority": "non_authoritative_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "job_id", "report_id", "session_id", "assessment_id", "status", "attempts"], "indexes": [{"name": "uq_ai_outbox_job", "keys": [["job_id", 1]], "unique": true}, {"name": "uq_ai_outbox_report_assessment", "keys": [["report_id", 1], ["assessment_id", 1]], "unique": true}, {"name": "ix_ai_outbox_claimable", "keys": [["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["created_at", 1], ["job_id", 1]]}]},
    {"name": "reconciliation_cursors", "canonical_key": "scope", "authority": "canonical_operational", "retention": "retain", "required_fields": ["_id", "schema_version", "scope", "payload_json", "payload_sha256", "updated_at"], "indexes": [{"name": "uq_reconciliation_cursor_scope", "keys": [["scope", 1]], "unique": true}]},
    {"name": "ai_advisories", "canonical_key": "advisory_id", "authority": "non_authoritative_derived", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "advisory_id", "cache_key", "report_id", "session_id", "assessment_id", "payload_json"], "indexes": [{"name": "uq_ai_advisory_id", "keys": [["advisory_id", 1]], "unique": true}, {"name": "uq_ai_advisory_cache", "keys": [["cache_key", 1]], "unique": true}, {"name": "ix_ai_advisory_session", "keys": [["session_id", 1], ["created_at", -1], ["advisory_id", 1]]}]},
    {"name": "enrichment_jobs", "canonical_key": "job_id", "authority": "non_authoritative_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "job_id", "status", "attempts"], "indexes": [{"name": "uq_enrichment_job", "keys": [["job_id", 1]], "unique": true}, {"name": "ix_enrichment_claimable", "keys": [["status", 1], ["priority", -1], ["next_retry_at", 1], ["claim_expires_at", 1], ["created_at", 1]]}]},
    {"name": "enrichment_records", "canonical_key": "_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "observable_type", "observable_value", "payload_json"], "indexes": [{"name": "uq_enrichment_observable", "keys": [["observable_type", 1], ["observable_value", 1]], "unique": true}]},
    {"name": "threat_hunt_jobs", "canonical_key": "job_id", "authority": "non_authoritative_operational", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "job_id", "status", "attempts"], "indexes": [{"name": "uq_threat_hunt_job", "keys": [["job_id", 1]], "unique": true}, {"name": "ix_threat_hunt_claimable", "keys": [["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["created_at", 1]]}]},
    {"name": "observables", "canonical_key": "observable_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "observable_id", "observable_type", "observable_value"], "indexes": [{"name": "uq_observable_identity", "keys": [["observable_type", 1], ["observable_value", 1]], "unique": true}]},
    {"name": "observable_sightings", "canonical_key": "sighting_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "sighting_id", "observable_id", "session_id"], "indexes": [{"name": "uq_observable_sighting", "keys": [["sighting_id", 1]], "unique": true}, {"name": "ix_sightings_session", "keys": [["session_id", 1], ["created_at", -1]]}]},
    {"name": "alerts", "canonical_key": "alert_id", "authority": "manual_review_only", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "alert_id", "session_id", "payload_json"], "indexes": [{"name": "uq_alert_id", "keys": [["alert_id", 1]], "unique": true}]},
    {"name": "webhook_deliveries", "canonical_key": "delivery_id", "authority": "manual_review_only", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "delivery_id", "status", "payload_json"], "indexes": [{"name": "uq_webhook_delivery", "keys": [["delivery_id", 1]], "unique": true}, {"name": "ix_webhook_claimable", "keys": [["target_url_hash", 1], ["status", 1], ["next_retry_at", 1], ["claim_expires_at", 1], ["updated_at", 1]]}]},
    {"name": "session_links", "canonical_key": "link_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "link_id", "session_id"], "indexes": [{"name": "uq_session_link", "keys": [["link_id", 1]], "unique": true}]},
    {"name": "campaigns", "canonical_key": "campaign_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "campaign_id", "payload_json"], "indexes": [{"name": "uq_campaign_id", "keys": [["campaign_id", 1]], "unique": true}]},
    {"name": "campaign_sessions", "canonical_key": "_id", "authority": "non_authoritative_context", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "campaign_id", "session_id"], "indexes": [{"name": "uq_campaign_session", "keys": [["campaign_id", 1], ["session_id", 1]], "unique": true}]},
    {"name": "analyst_feedback", "canonical_key": "feedback_id", "authority": "manual_review", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "feedback_id", "session_id", "payload_json"], "indexes": [{"name": "uq_analyst_feedback", "keys": [["feedback_id", 1]], "unique": true}]},
    {"name": "classification_review_labels", "canonical_key": "label_id", "authority": "manual_review", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "label_id", "session_id", "payload_json"], "indexes": [{"name": "uq_classification_review_label", "keys": [["label_id", 1]], "unique": true}]},
    {"name": "feed_status", "canonical_key": "feed_id", "authority": "operational_metadata", "retention": "policy_managed_no_ttl", "required_fields": ["_id", "schema_version", "feed_id", "payload_json"], "indexes": [{"name": "uq_feed_status", "keys": [["feed_id", 1]], "unique": true}]},
    {"name": "schema_manifests", "canonical_key": "manifest_sha256", "authority": "provenance", "retention": "retain", "required_fields": ["_id", "schema_version", "manifest_sha256", "payload_json"], "indexes": [{"name": "uq_schema_manifest", "keys": [["manifest_sha256", 1]], "unique": true}]},
    {"name": "lifecycle_ledger", "canonical_key": "policy_sha256", "authority": "provenance", "retention": "retain", "required_fields": ["_id", "schema_version", "policy_sha256", "activated_at"], "indexes": [{"name": "uq_lifecycle_policy", "keys": [["policy_sha256", 1]], "unique": true}]},
    {"name": "migration_receipts", "canonical_key": "receipt_id", "authority": "provenance", "retention": "retain", "required_fields": ["_id", "schema_version", "receipt_id", "payload_json", "payload_sha256"], "indexes": [{"name": "uq_migration_receipt", "keys": [["receipt_id", 1]], "unique": true}]}
  ]
}
