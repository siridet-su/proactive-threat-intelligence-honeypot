[Unit]
Description=Refresh honeypot threat-intelligence feed caches
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=honeypot
Group=honeypot
WorkingDirectory=/opt/honeypot
EnvironmentFile=/etc/honeypot/honeypot.env
ExecStart=/opt/honeypot/.venv/bin/python -m production.enrichment.refresh_feeds --config /etc/honeypot/production_config.json
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/honeypot/feeds
