[Unit]
Description=Honeypot Prediction Backtest Job
After=network-online.target honeypot-session-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=honeypot
WorkingDirectory=/opt/honeypot
EnvironmentFile=/etc/honeypot/honeypot.env
ExecStart=/opt/honeypot/.venv/bin/python -m production.prediction.prediction_backtest --config /etc/honeypot/production_config.json --include-cases --save
StandardOutput=journal
StandardError=journal
