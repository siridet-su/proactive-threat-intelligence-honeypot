DATABASE_URL_FILE=/etc/honeypot/credentials/enrichment-worker/database-url
EXTERNAL_ENRICHMENT_PROFILE=disabled
# Safe defaults: real external TI remains fail-closed until the operator
# supplies the explicit provider allowlist, credential files, cutoff, and
# proof-guard campaign below.
EXTERNAL_TI_ENABLED=false
EXTERNAL_TI_PROVIDER_ALLOWLIST=[]
EXTERNAL_TI_PROVIDER_CONFIGS_JSON={}
EXTERNAL_TI_PROOF_CAMPAIGN_ID=
EXTERNAL_TI_PROOF_GUARD_MODE=DISABLED
SOURCE_IP_ENRICHMENT_MODE=disabled
SOURCE_IP_ENRICHMENT_NOT_BEFORE_UTC=
SOURCE_IP_ENRICHMENT_CUTOFF_OPERATOR=
EXTERNAL_TI_SOURCE_IP_GOVERNANCE_PATH=configs/external_ti_source_ip_governance.v2.json
EXTERNAL_TI_SOURCE_IP_GOVERNANCE_SHA256=c993132174809ec1e4e598c3f65b7589b25199047d1b8d399c247806d596205e
OTX_API_KEY_FILE=/etc/honeypot/credentials/enrichment-worker/otx-api-key
ABUSEIPDB_API_KEY_FILE=/etc/honeypot/credentials/enrichment-worker/abuseipdb-api-key
SHODAN_API_KEY_FILE=/etc/honeypot/credentials/enrichment-worker/shodan-api-key
VIRUSTOTAL_API_KEY_FILE=/etc/honeypot/credentials/enrichment-worker/virustotal-api-key
