# Optional AI remains disabled until a reviewed activation receipt exists.
DATABASE_URL_FILE=/etc/honeypot/credentials/mongodb-uri
ENABLE_AI_ADVISORY=false
AI_ADVISORY_ACTIVATION_RECEIPT_PATH=/etc/honeypot/ai-advisory-activation.json
AI_ADVISORY_ALIAS_KEY_FILE=/etc/honeypot/credentials/ai-advisory-alias-key
AI_ADVISORY_RECONCILIATION_CUTOFF_JSON={}
# Reviewed non-secret Vertex/ADC settings. These do not activate the worker.
AI_ADVISORY_PROVIDER=google_vertex_gemini
AI_ADVISORY_PROJECT=replace-with-gce-project-id
AI_ADVISORY_LOCATION=global
AI_ADVISORY_MODEL=gemini-3.6-flash
AI_ADVISORY_ENDPOINT=https://aiplatform.googleapis.com
AI_ADVISORY_API_VERSION=v1
AI_ADVISORY_ADAPTER_REVISION=replace-with-reviewed-adapter
AI_ADVISORY_ALLOWED_HOSTS_JSON=[\"aiplatform.googleapis.com\"]
AI_ADVISORY_REQUEST_OPTIONS_JSON={}
# The Vertex adapter uses standard ADC discovery. AI_ADVISORY_API_KEY_FILE must
# remain unset; never put ADC JSON or OAuth tokens in an EnvironmentFile.
# On GCE, the intended production source is the VM attached service account via
# the metadata server. Readiness must separately verify its project, OAuth
# scopes, and IAM before issuing an activation receipt.
