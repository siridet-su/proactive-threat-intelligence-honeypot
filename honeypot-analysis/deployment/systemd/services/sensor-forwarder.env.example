HONEYPOT_API_TOKEN_FILE=/etc/honeypot/credentials/sensor-forwarder/ingest-token
SENSOR_ID=pi5-cowrie-01
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json
FORWARDER_SPOOL_PATH=/var/lib/honeypot-forwarder/sensor_spool.ndjson
FORWARDER_QUARANTINE_PATH=/var/lib/honeypot-forwarder/rejected-events.quarantine.ndjson
FORWARDER_MAX_QUARANTINE_BYTES=16777216
FORWARDER_MAX_QUARANTINE_EVENTS=1000
INGEST_URL=https://YOUR-INGEST-SERVICE/events
