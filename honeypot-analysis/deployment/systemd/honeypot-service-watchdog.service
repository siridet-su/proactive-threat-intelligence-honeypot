[Unit]
Description=PTI-Honeypot bounded service recovery watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/honeypot-service-watchdog.py --config /etc/honeypot/service-watchdog.json --state /var/lib/honeypot-service-watchdog/status.json --lock /run/honeypot-service-watchdog/watchdog.lock
RuntimeDirectory=honeypot-service-watchdog
RuntimeDirectoryMode=0750
StateDirectory=honeypot-service-watchdog
StateDirectoryMode=0750
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/honeypot-service-watchdog /var/lib/honeypot-service-watchdog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

