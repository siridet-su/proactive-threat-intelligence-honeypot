# Copy to /etc/honeypot/honeypot.env and set real secrets there.
# Keep this file readable only by the service user/root in production.
# Do not put the credential-HMAC key or keyring JSON here. The session worker
# receives that worker-only secret through systemd LoadCredential.

HONEYPOT_CONFIG_FILE=/etc/honeypot/production_config.json
HONEYPOT_API_TOKEN=replace-with-secret-manager-token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/honeypot

# Service binding.
INGEST_HOST=0.0.0.0
INGEST_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8081

# Analysis behavior.
ANALYSIS_SKIP_EMPTY_SESSIONS=true
ANALYSIS_SUPPRESS_STDOUT=true
ANALYSIS_FALLBACK_ON_FAILURE=true

# SecureBERT.
ENABLE_SECUREBERT=true
SECUREBERT_PATH=/opt/honeypot/models/securebert_ttp
SECUREBERT_CHECKPOINT_PATH=
SECUREBERT_DEVICE=auto

# Feeds and enrichment.
ENABLE_FEED_LOADING=true
CISA_CACHE_PATH=/var/lib/honeypot/feeds/cisa_kev_cache.json
SIGMA_CACHE_PATH=/var/lib/honeypot/feeds/sigma_rules_cache.json
MITRE_ATTACK_PATH=/var/lib/honeypot/feeds/mitre_attack_cache.json
ENRICHMENT_DB_PATH=
ENABLE_ENRICHMENT_JOBS=true
ENRICHMENT_ALLOW_STALE=true
ENRICHMENT_PROVIDER_TIMEOUT_SECONDS=20
ENRICHMENT_PROVIDER_WORKERS=4
ENRICHMENT_PROVIDER_HTTP_RETRIES=1
ENRICHMENT_PROVIDER_RETRY_DELAY_SECONDS=0.25
ENRICHMENT_PROVIDER_MAX_RESPONSE_BYTES=1048576

# Provider keys are needed only by honeypot-enrichment-worker.
OTX_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Vertex/Gemini. Leave project blank if deterministic fallback is enough for a pilot.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro

# Output and notifications.
REPORTS_DIR=/var/lib/honeypot/reports
WEBHOOK_URL=

# Frozen Transformer operations. These two paths are a provenance pair: the
# session classifier and prediction policy must name the same reviewed rule file.
PREDICTION_SNAPSHOT_RETENTION_DAYS=90
PREDICTION_SNAPSHOT_KEEP_LATEST_PER_SESSION=true
PREDICTION_POLICY_PATH=/opt/honeypot/configs/prediction_policy.trusted.json
CLASSIFICATION_RULES_PATH=/opt/honeypot/configs/classification_rules.trusted.json
ENABLE_SESSION_TTP_CORRELATION=true
SESSION_TTP_CORRELATION_POLICY_PATH=/etc/honeypot/session_ttp_correlation.trusted.json
SESSION_TTP_KNOWLEDGE_PACK_PATHS=/var/lib/honeypot/session_ttp_knowledge_pack.json

# Webhooks remain disabled unless WEBHOOK_URL or WEBHOOK_TARGETS_JSON is set.
# Store only a private key-file path here, never the signing key itself.
WEBHOOK_SIGNING_KEY_FILE=
WEBHOOK_ALLOWED_SCHEMES=https
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_DNS_TIMEOUT_SECONDS=5

# Pi forwarder only.
SENSOR_ID=pi5-cowrie-01
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json
FORWARDER_SPOOL_PATH=/var/lib/honeypot-forwarder/sensor_spool.ndjson
FORWARDER_MAX_SPOOL_BYTES=67108864
FORWARDER_MIN_FREE_BYTES=33554432
FORWARDER_MAX_LINE_BYTES=262144
INGEST_URL=https://YOUR-INGEST-SERVICE/events
