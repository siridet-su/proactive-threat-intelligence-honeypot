[Unit]
Description=Honeypot ingest API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=honeypot
Group=honeypot
WorkingDirectory=/opt/honeypot
EnvironmentFile=/etc/honeypot/honeypot.env
ExecStart=/opt/honeypot/.venv/bin/python -m production.api.ingest_api --config /etc/honeypot/production_config.json
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/honeypot

[Install]
WantedBy=multi-user.target
