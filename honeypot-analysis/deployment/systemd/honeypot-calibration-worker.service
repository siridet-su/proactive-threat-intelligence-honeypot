[Unit]
Description=Honeypot Prediction Weight Calibration Job
After=network-online.target honeypot-prediction-backtest.service
Wants=network-online.target

[Service]
Type=oneshot
User=honeypot
WorkingDirectory=/opt/honeypot
EnvironmentFile=/etc/honeypot/honeypot.env
ExecStart=/opt/honeypot/.venv/bin/python -m production.workers.calibration_worker --config /etc/honeypot/production_config.json
StandardOutput=journal
StandardError=journal
