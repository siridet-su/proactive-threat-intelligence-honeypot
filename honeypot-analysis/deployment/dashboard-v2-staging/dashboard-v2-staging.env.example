# Install as /etc/honeypot/services/dashboard-v2-staging.env with mode 0600.
# The bootstrap script generates the three dashboard auth values with a CSPRNG.
# No Mongo URI, Mongo credential, production dashboard credential, or Cloudflare
# token belongs in this file.
DASHBOARD_API_ORIGIN=http://127.0.0.1:8090
DASHBOARD_V2_OPERATOR_ID=staging-operator
DASHBOARD_V2_ACCESS_KEY=<generate-with-bootstrap-script>
DASHBOARD_V2_SESSION_SECRET=<generate-with-bootstrap-script>
NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
