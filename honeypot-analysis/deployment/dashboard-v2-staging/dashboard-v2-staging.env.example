# Install as /etc/honeypot/services/dashboard-v2-staging.env with mode 0600.
# Bootstrap creates blank values. The operator fills them in the actual
# root-owned env file before deployment; do not copy values into Git.
DASHBOARD_MONITOR_BASE_URL=http://127.0.0.1:8090
# Same owner-only credential file configured for monitor-web. The Next server
# reads it server-side and forwards it only to the loopback raw-command route.
MONITOR_RAW_COMMANDS_TOKEN_FILE=/etc/honeypot/credentials/monitor-web/raw-commands-token
MONGODB_URI=
PTI_ADMIN_PASSWORD=
AUTH_SESSION_SECRET=
NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
