# Shared Redis, MongoDB, retention, and TI stream settings are loaded from
# /etc/honeypot-agent.env by the systemd unit. Keep this file private and
# store only worker-specific settings here.
TI_CONSUMER_GROUP=ti-worker
TI_CONSUMER_NAME=ti-worker-1

# Read-only lookup keys. Do not enable provider uploads or AbuseIPDB reporting.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

TI_HTTP_TIMEOUT=8s
TI_CACHE_TTL=168h
VT_MAX_REQUESTS_PER_MINUTE=3
VT_MAX_REQUESTS_PER_DAY=400
ABUSEIPDB_MAX_REQUESTS_PER_MINUTE=10
ABUSEIPDB_MAX_REQUESTS_PER_DAY=800
